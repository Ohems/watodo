# Watodo environment configuration sample.
#
# Standard configuration (server, logging, databases, URLs, job tuning) is set
# below and works out of the box with the bundled docker-compose.yml. Optional
# feature credentials (OAuth login providers, web push) are commented out:
# those features stay disabled until you uncomment and set real values. The
# comments show the expected format of each value.

export NODE_ENV=development

export PORT=3000
export HOST=0.0.0.0

# Logging: set to false to disable all log output (e.g. in tests)
export LOG_ENABLED=true
export LOG_LEVEL=info

# PostgreSQL database. Format: postgres://<user>:<password>@<host>:<port>/<database>
# (matches the bundled docker-compose.yml)
export DATABASE_URL=postgres://watodo:dbPass123@localhost:5432/watodo

# Pending database migrations are applied automatically when the backend
# starts. Set to false to disable that and run `npm run migrate -w backend`
# manually instead.
export AUTO_MIGRATE=true

# Redis. Format: redis://<host>:<port>
export REDIS_URL=redis://localhost:6379

# OAuth login providers. A provider only shows up as configured when BOTH its
# ID and secret are set; leave them commented out to disable that provider.
# Discord app: https://discord.com/developers/applications
# export DISCORD_CLIENT_ID=<numeric application id>
# export DISCORD_CLIENT_SECRET=<client secret>
# Google: https://console.cloud.google.com/apis/credentials (OAuth client)
# export GOOGLE_CLIENT_ID=<client id>.apps.googleusercontent.com
# export GOOGLE_CLIENT_SECRET=<client secret>
# Microsoft: https://entra.microsoft.com (App registrations)
# export MICROSOFT_CLIENT_ID=<application (client) id, a GUID>
# export MICROSOFT_CLIENT_SECRET=<client secret>

# The public base URL of the backend, used to build OAuth redirect URLs
export BASE_URL=http://localhost:3000

# Public URL of the web app, used for links inside notification emails
export APP_URL=http://localhost:5173

# Critical-slot alert job: notify series managers about occurrences within this
# many days that still have unfilled critical slots, checked on this interval
export CRITICAL_SLOT_ALERT_DAYS=7
export CRITICAL_SLOT_ALERT_INTERVAL_MINUTES=60

# Web push (VAPID) keys for push notifications. Generate a pair once with
# `npx web-push generate-vapid-keys` (run from backend/). Push delivery stays
# disabled while these are unset. VAPID_SUBJECT is a contact for the push
# service, usually a mailto: address.
# export VAPID_PUBLIC_KEY=<url-safe base64 public key, 87 characters>
# export VAPID_PRIVATE_KEY=<url-safe base64 private key, 43 characters>
# export VAPID_SUBJECT=mailto:you@example.com

# Email delivery for notifications. MAIL_PROVIDER selects the backend:
# resend | mailgun | usesend | smtp. Leave it commented out to disable email
# delivery entirely (the account page then shows a "not configured" note).
# MAIL_FROM is the sender address and must be verified at the provider, e.g.
# "Watodo <notifications@example.com>". Only the selected provider's
# credentials below are needed.
# export MAIL_PROVIDER=resend
# export MAIL_FROM="Watodo <notifications@example.com>"
# Resend (https://resend.com): API key from the dashboard
# export RESEND_API_KEY=re_xxxxxxxx
# Mailgun (https://www.mailgun.com): API key + sending domain; region us (default) or eu
# export MAILGUN_API_KEY=key-xxxxxxxx
# export MAILGUN_DOMAIN=mg.example.com
# export MAILGUN_REGION=us
# useSend (https://usesend.com), cloud or self-hosted; point USESEND_BASE_URL
# at a self-hosted instance (default https://api.usesend.com)
# export USESEND_API_KEY=usesend_xxxxxxxx
# export USESEND_BASE_URL=https://api.usesend.com
# SMTP via nodemailer (optional dependency, installed by `npm install` in backend/)
# export SMTP_HOST=smtp.example.com
# export SMTP_PORT=587
# export SMTP_SECURE=false
# export SMTP_USER=smtp-user
# export SMTP_PASS=smtp-password
