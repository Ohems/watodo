export NODE_ENV=development

export PORT=3000
export HOST=0.0.0.0

# PostgreSQL database
export DATABASE_URL=postgres://watodo:dbPass123@localhost:5432/watodo

# Redis
export REDIS_URL=redis://localhost:6379

# Discord OAuth
export DISCORD_CLIENT_ID=your-discord-client-id
export DISCORD_CLIENT_SECRET=your-discord-client-secret

# Google OAuth
export GOOGLE_CLIENT_ID=your-google-client-id
export GOOGLE_CLIENT_SECRET=your-google-client-secret

# Microsoft OAuth
export MICROSOFT_CLIENT_ID=your-microsoft-client-id
export MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# The public base URL of the backend
export BASE_URL=http://localhost:3000
