# Test environment for the backend test suite. This file is committed to Git
# on purpose: it contains only placeholder values, no real secrets. It is
# loaded by backend/tests/setup.ts before any test file runs, so integration
# tests use the dedicated test database instead of the development database.

export LOG_LEVEL=error
export NODE_ENV=test

export PORT=3000
export HOST=0.0.0.0

# PostgreSQL test database (watodo-postgres-test container, host port 6432)
export DATABASE_URL=postgres://watodo:dbPass123@localhost:6432/watodo_test

# Redis (shared with development)
export REDIS_URL=redis://localhost:6379

# OAuth credentials are not used by tests (providers are mocked); placeholders
export DISCORD_CLIENT_ID=test-discord-client-id
export DISCORD_CLIENT_SECRET=test-discord-client-secret

# Google OAuth
export GOOGLE_CLIENT_ID=test-google-client-id
export GOOGLE_CLIENT_SECRET=test-google-client-secret

# Microsoft OAuth
export MICROSOFT_CLIENT_ID=test-microsoft-client-id
export MICROSOFT_CLIENT_SECRET=test-microsoft-client-secret

# The public base URL of the backend
export BASE_URL=http://localhost:3000
